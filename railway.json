{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd fundraise-backend && chmod +x mvnw && ./mvnw clean package -DskipTests -B -q"
  },
  "deploy": {
    "startCommand": "cd fundraise-backend && java -jar target/*.jar --spring.profiles.active=prod",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
